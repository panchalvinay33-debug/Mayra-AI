<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.DIAL" /><data android:scheme="tel" /></intent>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="smsto" /></intent>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.intent.action.OPEN_DOCUMENT" /><category android:name="android.intent.category.OPENABLE" /><data android:mimeType="*/*" /></intent>
        <intent><action android:name="android.intent.action.INSERT" /><data android:mimeType="vnd.android.cursor.dir/event" /></intent>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
    </queries>

    <application
        android:name=".MayraApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:label="Mayra AI"
        android:theme="@style/Theme.MayraAI">
        <activity android:name=".workspace.MayraWorkspaceActivity" android:exported="false" />
        <activity android:name=".diagnostics.MayraStartupDiagnosticsActivity" android:exported="false" />
        <activity android:name=".document.MayraDocumentReaderActivity" android:exported="false" />
        <activity android:name=".memory.MayraMemoryPrivacyActivity" android:exported="false" />
        <activity android:name=".memory.MayraMemoryBackupActivity" android:exported="false" />
        <activity android:name=".document.MayraDocumentActivity" android:exported="false" />
        <activity android:name=".memory.MayraVoiceNotesActivity" android:exported="false" />
        <activity android:name=".memory.MayraMemoryActivity" android:exported="false" />
        <activity android:name=".floating.FloatingMayraActivity" android:exported="false" />
        <activity android:name=".testing.MayraDeviceTestActivity" android:exported="false" />
        <activity android:name=".calendar.MayraAgendaActivity" android:exported="false" />
        <activity android:name=".reminder.MayraReminderActivity" android:exported="false" />
        <activity android:name=".identity.MayraIdentityActivity" android:exported="false" />
        <activity android:name=".owner.MayraOwnerSetupActivity" android:exported="false" />
        <activity android:name=".background.MayraNotificationCenterActivity" android:exported="false" />
        <activity android:name=".action.MayraActionControlActivity" android:exported="false" />
        <activity android:name=".pulse.MayraPulseActivity" android:exported="false" />
        <activity android:name=".ai.AiProviderActivity" android:exported="false" />
        <activity android:name=".settings.SettingsActivity" android:exported="false" />
        <activity android:name=".runtime.RuntimeControlActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".presence.MayraPresenceActivity" android:exported="false" />
        <activity android:name=".presence.MayraCompanionActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".floating.FloatingMayraService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled floating Mayra companion overlay" />
        </service>
        <service android:name=".assistive.MayraAssistiveService" android:exported="false" android:label="Mayra assistive context" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/mayra_accessibility_service" />
        </service>
        <service android:name=".background.MayraNotificationListener" android:exported="false" android:label="Mayra notification intelligence" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
            <meta-data android:name="android.service.notification.default_filter_types" android:value="conversations|alerting" />
            <meta-data android:name="android.service.notification.disabled_filter_types" android:value="ongoing|silent" />
        </service>
        <receiver android:name=".reminder.MayraReminderActionReceiver" android:exported="false" />
        <receiver android:name=".runtime.RuntimeAttentionActionReceiver" android:exported="false" />
        <receiver android:name=".background.MayraBootReceiver" android:enabled="true" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
    </application>
</manifest>