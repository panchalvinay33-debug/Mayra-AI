<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Owner-device safe UI build. Production Mayra may use online AI and device capabilities,
      while this sideloaded development variant stays deliberately offline and low-permission.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_CONTACTS" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />

    <application
        android:label="Mayra AI Full Test"
        tools:replace="android:label">

        <service
            android:name=".assistant.MayraVoiceInteractionService"
            tools:node="remove" />
        <service
            android:name=".assistant.MayraVoiceInteractionSessionService"
            tools:node="remove" />
        <service
            android:name=".assistant.MayraRecognitionService"
            tools:node="remove" />
        <service
            android:name=".background.MayraNotificationListener"
            tools:node="remove" />

        <receiver
            android:name=".background.MayraBootReceiver"
            tools:node="remove" />
    </application>
</manifest>
